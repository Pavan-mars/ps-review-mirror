# ============================================================================
# CUBIC MARS - Environment Variables
# Copy this file to .env and fill in actual values
# ============================================================================

# ---- Application ----
VITE_APP_TITLE=CUBIC MARS - Predictive Analytics Dashboard
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development  # development | uat | production

# ---- API Configuration ----
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# ---- Authentication ----
VITE_AUTH_JWT_EXPIRY_MINS=30
VITE_AUTH_REFRESH_EXPIRY_DAYS=7

# ---- Feature Flags ----
VITE_FEATURE_MOCK_DATA=true      # Set to false when API is ready
VITE_FEATURE_MOCK_AUTH=true      # Set to false when auth API is ready
VITE_FEATURE_TOC_ENABLED=true   # Enable TOC sub-filters

# ---- AWS (Backend .env - not exposed to frontend) ----
# DB_HOST=cubic-mars-db.xxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=cubic_mars
# DB_USER=cubic_admin
# DB_PASSWORD=<secure-password>
# DB_SSL=true

# REDIS_HOST=cubic-mars-cache.xxxxx.cache.amazonaws.com
# REDIS_PORT=6379

# JWT_SECRET=<256-bit-secret>
# JWT_ALGORITHM=HS256

# AWS_REGION=us-east-1
# S3_MODEL_BUCKET=cubic-mars-ml-models
# SAGEMAKER_ENDPOINT_PREFIX=cubic-mars-inference

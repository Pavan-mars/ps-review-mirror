{
  "family": "cubic-mars-ps2-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "REPLACE_WITH_ecsTaskExecutionRole_ARN",
  "taskRoleArn": "REPLACE_WITH_dashboard_task_role_ARN",
  "containerDefinitions": [
    {
      "name": "dashboard",
      "image": "REPLACE_WITH_ECR_IMAGE_URI:TAG",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:8080/healthz || exit 1"],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cubic-mars-ps2-dashboard",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "dashboard",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

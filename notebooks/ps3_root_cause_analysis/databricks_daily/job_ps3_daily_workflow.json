{
  "name": "cubic-chicago-ps3-daily",
  "tags": {"program": "cubic-mars", "city": "chicago", "ps": "ps3", "env": "dev"},
  "timeout_seconds": 10800,
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 7 * * ?",
    "timezone_id": "America/Chicago",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {"on_failure": ["pavan.kumar@mars-techs.com"]},
  "job_clusters": [
    {
      "job_cluster_key": "ps3_daily_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "m5d.xlarge",
        "num_workers": 2,
        "aws_attributes": {"availability": "SPOT_WITH_FALLBACK", "first_on_demand": 1},
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {"spark.databricks.delta.formatCheck.enabled": "false"}
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_cdc_incremental",
      "description": "NB75 contract-driven bronze incremental (catches new Oracle inserts+updates).",
      "job_cluster_key": "ps3_daily_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/notebooks/ingestion/75_CDC_INCREMENTAL_ENGINE",
        "base_parameters": {"DRY_RUN": "False"}
      }
    },
    {
      "task_key": "ps3_silver_gold_incremental",
      "description": "Refresh PS3 silver chain + MERGE gold.device_ps3_incident on availability_event_id.",
      "depends_on": [{"task_key": "bronze_cdc_incremental"}],
      "job_cluster_key": "ps3_daily_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/notebooks/ps3_root_cause_analysis/ps3_daily_incremental",
        "base_parameters": {"INCREMENTAL_MODE": "merge", "DRY_RUN": "false"}
      }
    },
    {
      "task_key": "export_ps3_to_s3",
      "description": "Full snapshot + new-incident slice to S3 for the scorer.",
      "depends_on": [{"task_key": "ps3_silver_gold_incremental"}],
      "job_cluster_key": "ps3_daily_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/notebooks/ps3_root_cause_analysis/export_gold_ps3_incremental_to_s3"
      }
    },
    {
      "task_key": "sagemaker_batch_score",
      "description": "Trigger the SageMaker Batch Transform (both heads) on the new-incident slice.",
      "depends_on": [{"task_key": "export_ps3_to_s3"}],
      "job_cluster_key": "ps3_daily_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/sagemaker/ps3/batch_transform_daily.py",
        "parameters": ["--asof", "{{tasks.export_ps3_to_s3.values.asof}}",
                       "--input-s3", "{{tasks.export_ps3_to_s3.values.incr_s3_uri}}"]
      }
    },
    {
      "task_key": "rds_upsert",
      "description": "Idempotent upsert of scored feeds into RDS (incident/device/serial, both heads).",
      "depends_on": [{"task_key": "sagemaker_batch_score"}],
      "job_cluster_key": "ps3_daily_cluster",
      "spark_python_task": {
        "python_file": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/databricks/ps3_rds_writer.py",
        "parameters": ["--outputs", "s3://cubic-mars-pm-s3-datalake-dev-gold-170202974600/chicago/ps3/scored/{{tasks.export_ps3_to_s3.values.asof}}",
                       "--city", "CHI", "--secret", "cubic/rds/dashboard",
                       "--asof", "{{tasks.export_ps3_to_s3.values.asof}}"]
      }
    }
  ]
}

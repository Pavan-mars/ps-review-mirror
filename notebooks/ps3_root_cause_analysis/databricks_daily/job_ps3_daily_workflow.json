{
  "_comment": "Reference workflow — deploy via databricks.yml (medallion_ps3_daily). SageMaker scoring + RDS run on AWS via EventBridge, not inside this Databricks job.",
  "name": "cubic-chicago-ps3-daily",
  "tags": {"program": "cubic-mars", "city": "chicago", "ps": "ps3", "env": "dev"},
  "timeout_seconds": 10800,
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 7 * * ?",
    "timezone_id": "America/Chicago",
    "pause_status": "PAUSED"
  },
  "email_notifications": {"on_failure": ["pavan.kumar@mars-techs.com"]},
  "job_clusters": [
    {
      "job_cluster_key": "ps3_daily_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "m5d.xlarge",
        "num_workers": 2,
        "aws_attributes": {"availability": "SPOT_WITH_FALLBACK", "first_on_demand": 1},
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {"spark.databricks.delta.formatCheck.enabled": "false"}
      }
    }
  ],
  "tasks": [
    {
      "task_key": "ps3_silver_gold_incremental",
      "description": "Refresh PS3 silver chain + MERGE gold.device_ps3_incident on availability_event_id. Run after bronze CDC when ingest is live.",
      "job_cluster_key": "ps3_daily_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/notebooks/ps3_root_cause_analysis/databricks_daily/ps3_daily_incremental",
        "base_parameters": {"INCREMENTAL_MODE": "merge", "DRY_RUN": "false"}
      }
    },
    {
      "task_key": "export_ps3_to_s3",
      "description": "Full snapshot + new-incident slice to S3 for the scorer.",
      "depends_on": [{"task_key": "ps3_silver_gold_incremental"}],
      "job_cluster_key": "ps3_daily_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/notebooks/ps3_root_cause_analysis/databricks_daily/export_gold_ps3_incremental_to_s3"
      }
    },
    {
      "task_key": "ps3_gold_complete_event",
      "description": "Verify PS3 gold rows, emit PS3 Gold Export Complete to EventBridge.",
      "depends_on": [{"task_key": "export_ps3_to_s3"}],
      "job_cluster_key": "ps3_daily_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/mars/Chicago-Ventra-Mars-Cubic-Analysis/notebooks/ps3_gold_complete_event",
        "base_parameters": {
          "catalog": "mars_dev",
          "city_id": "CHI",
          "dry_run": "false"
        }
      }
    }
  ]
}
